DATABASE_URL=postgresql://postgres:password@localhost:5432/safe_lima
DATABASE_ECHO=false
TZ=America/Lima
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SCHEDULER_TOKEN=replace-with-a-long-random-token

GCS_BUCKET_NAME=safelima-evidencias
GCS_FOLDER_ALERTS=user_alerts
GCS_PROJECT_ID=project-id

# ML models
# Local development:
# ML_MODEL_SOURCE=local
# ML_BATCH_MODEL_PATH=app/ml_models/modelo_riesgo_batch.pkl
# ML_ONLINE_MODEL_PATH=app/ml_models/modelo_riesgo_online.pkl
#
# Cloud Run/default GCS mode uses ADC and does not require JSON credentials:
ML_MODEL_SOURCE=gcs
GCS_ML_BUCKET=safelima-ml-models
ML_BATCH_MODEL_BLOB=models/risk/batch/modelo_riesgo_batch.pkl
ML_ONLINE_MODEL_BLOB=models/risk/online/modelo_riesgo_online.pkl
ML_LOCAL_DIR=/tmp/safelima_models
ML_BATCH_MODEL_PATH=app/ml_models/modelo_riesgo_batch.pkl
ML_ONLINE_MODEL_PATH=app/ml_models/modelo_riesgo_online.pkl

# Cloud Scheduler
# Use a long random value stored in Secret Manager for Cloud Run.
# Configure the same value in Cloud Scheduler as X-Scheduler-Token.
# Never commit real scheduler tokens.
